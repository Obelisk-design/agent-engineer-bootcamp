{
  "name": "agent-engineer-bootcamp",
  "version": "0.1.0",
  "private": true,
  "description": "65-day AI Agent Engineer Bootcamp — TypeScript monorepo for interview showcase (first 20 days)",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "vue-tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json",
    "dev": "nodemon",
    "dev:example": "nodemon examples/day01/ex_001_chat_completion.ts",
    "dev:smoke": "nodemon examples/day01/ex_002_nodemon_smoke.ts",
    "dev:api": "pnpm exec tsx scripts/with-ports.ts api 3000 -- tsx examples/day08/agent_server.ts",
    "dev:api:day09": "pnpm exec tsx scripts/with-ports.ts api 3000 -- tsx examples/day09/agent_server.ts",
    "dev:web": "pnpm exec tsx scripts/with-ports.ts web 5173 -- vite --host 127.0.0.1",
    "dev:day08": "pnpm exec tsx scripts/dev-day08.ts",
    "dev:day09": "pnpm exec tsx scripts/dev-day09.ts",
    "prepare": "husky || true",
    "commitlint": "commitlint --edit"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "@hono/node-server": "^2.0.11",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.9",
    "@langchain/openai": "^1.5.9",
    "@langchain/textsplitters": "^1.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^2.1.8",
    "concurrently": "^10.0.4",
    "dotenv": "^17.4.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "langchain": "^1.5.10",
    "lint-staged": "^15.3.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@bootcamp/api-schema": "workspace:*",
    "@lancedb/lancedb": "^0.37.1",
    "@notionhq/client": "^2.3.0",
    "gpt-tokenizer": "^3.4.0",
    "hono": "^4.12.31",
    "openai": "^6.47.0",
    "zod": "^4.4.3"
  }
}
