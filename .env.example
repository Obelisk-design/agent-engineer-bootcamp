# ===== Notion import (Task 7, 2026-08-25) =====
# Personal Notion integration secret (create at notion.so/my-integrations)
# After creating it, share each page you want indexed with that integration.
# Real values go in .env (gitignored). This file is a template only;
# duplicate keys here (e.g. OPENAI_API_KEY at line 7 + line 14) are
# documentation placeholders. `dotenv/config` loads .env on top of this
# file, so .env wins at runtime.
NOTION_TOKEN=secret_xxxxx

# Embedding API for Notion import (separate from bootcamp env below for clarity)
OPENAI_API_KEY=sk-xxxxx
OPENAI_BASE_URL=
EMBEDDING_MODEL_NAME=

# ===== Bootcamp env (existing — Day 02/03/04/07 + Day 12 demo) =====
# OpenAI 兼容 API 配置（任何支持 OpenAI Chat Completions 协议的服务）
# 从 .env 复制此文件并填入真实值。
# 注意：以下三行**留空** —— 代码内不再保留任何默认值，必须由部署/调用方显式声明。
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=
MODEL_NAME=

# Anthropic Messages API 配置（用于 examples/day02/ex_002_anthropic_chat_client.ts）
# 真实 ANTHROPIC_AUTH_TOKEN 只写到 .env（gitignored），本文件只放占位
ANTHROPIC_AUTH_TOKEN=sk-your-anthropic-key-here
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5-...
ANTHROPIC_MAX_TOKENS=1024

# Day 12 — Embedding demo
# dev-only; consumed by apps/web via import.meta.env.VITE_OPENAI_API_KEY
# (copy from OPENAI_API_KEY in your local .env)
# 注意：留空 —— 代码内不再有默认值；env 缺位时由前端 banner 提示。
VITE_OPENAI_API_KEY=
# Optional: override OpenAI-compatible endpoint
VITE_OPENAI_BASE_URL=
# Optional: override embedding model
VITE_OPENAI_EMBEDDING_MODEL=